# Local-only, synthetic data. Never connect the public tree to a private DB.
APP_ENV=local
ENVIRONMENT=development
APP_BASE_URL=http://localhost:5173
HUB_PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgresql://dev:dev@127.0.0.1:55433/app

# With no .env, AUTH_MODE=disabled denies every bundle/profile read/write.
# Dev maps to forwarded-auth's `none` mode, requiring a *second*, explicit
# insecure-mode opt-in; both environment flags must be local/test.
# Only use on a loopback-only development server with synthetic data.
AUTH_MODE=dev
AUTH_ALLOW_INSECURE_DEV_MODE=true
DEV_BYPASS_EMAIL=dev@example.org
DEV_BYPASS_NAME=Dev User

# To use a production identity provider, fill in issuer, audience and exact
# domains (all required); JWKS URL is optional when the issuer supports OIDC
# discovery. Never put a signing secret here.
# AUTH_MODE=forwarded        # edge forwards a verified bearer JWT and headers
# AUTH_ISSUER=https://login.example.org
# AUTH_AUDIENCE=phi-hub
# AUTH_JWKS_URL=https://login.example.org/.well-known/jwks.json
# AUTH_ALLOWED_DOMAINS=example.org
# AUTH_TRUST_FORWARDED_HEADERS=true  # ALSO permits header-only edge identity
# AUTH_EMAIL_HEADER=X-Auth-Request-Email
# AUTH_NAME_HEADER=X-Auth-Request-Name
# AUTH_TRUST_MCP_HEADERS=false       # separate header-only MCP edge opt-in
# AUTH_MCP_EMAIL_HEADER=X-MCP-User-Email
# AUTH_MCP_NAME_HEADER=X-MCP-User-Name
# AUTH_ALLOWED_HOSTS=hub.example.org # MCP Host/Origin allowlist, not identity
# AUTH_ALLOW_LOOPBACK_HOSTS=false    # true only for local/tests, never production
# Build frontend with VITE_SIGN_IN_URL=https://login.example.org/start
# AUTH_LOGOUT_URL=https://login.example.org/logout
# Proxy MUST authenticate, strip client-provided identity headers, and block
# direct backend access. Non-phk Bearer credentials always require valid JWTs.
# Direct bearer-only clients can use AUTH_MODE=oidc and leave both header trust
# switches off; issuer, audience, and allowed domains remain mandatory.

# Optional marketplace organization. If omitted, NO org/publisher is seeded.
# Set all four before deploying one, and use an address no user can sign in as.
# ORG_HANDLE=team
# ORG_DISPLAY_NAME=Example Team
# ORG_EMAIL=hub-org@example.org
# ORG_INITIAL_PUBLISHERS=publisher@example.org

CORS_ORIGINS=["http://localhost:5173"]
