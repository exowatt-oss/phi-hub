# Local-only, synthetic data. Never connect the public tree to a private DB.
APP_ENV=local
ENVIRONMENT=development
APP_BASE_URL=http://localhost:5173
HUB_PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgresql://dev:dev@127.0.0.1:55433/app

# Default AUTH_MODE=disabled denies every bundle read/write. Only use dev
# on your own machine; production mode rejects it at settings validation.
AUTH_MODE=dev
DEV_BYPASS_EMAIL=dev@example.org
DEV_BYPASS_NAME=Dev User

# To use an authenticated proxy instead of local dev mode:
# AUTH_MODE=forwarded
# AUTH_TRUST_FORWARDED_HEADERS=true
# AUTH_EMAIL_HEADER=X-Auth-Request-Email
# AUTH_NAME_HEADER=X-Auth-Request-Name
# AUTH_TRUST_MCP_HEADERS=false
# AUTH_MCP_EMAIL_HEADER=X-MCP-User-Email
# AUTH_MCP_NAME_HEADER=X-MCP-User-Name
# AUTH_ALLOWED_DOMAINS=example.org
# AUTH_ALLOWED_HOSTS=hub.example.org
# Build frontend with VITE_SIGN_IN_URL=https://login.example.org/start
# AUTH_LOGOUT_URL=https://login.example.org/logout
# The proxy MUST strip client identity headers, authenticate each request,
# block direct backend port access, and protect /api AND /mcp.

# Optional marketplace organization. If omitted, NO org/publisher is seeded.
# Set all four before deploying one, and use an address no user can sign in as.
# ORG_HANDLE=team
# ORG_DISPLAY_NAME=Example Team
# ORG_EMAIL=hub-org@example.org
# ORG_INITIAL_PUBLISHERS=publisher@example.org

CORS_ORIGINS=["http://localhost:5173"]
